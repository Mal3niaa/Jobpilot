# ─── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed origins.
# Add your production frontend URL here (e.g. https://jobpilot.vercel.app).
CORS_ORIGIN=http://localhost:5501,http://127.0.0.1:5501

# ─── Database ────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local (Docker Compose):
DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5432/jobpilot
# Production (Railway, Render, Neon, etc.):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# REQUIRED in production — server refuses to start with the default value.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── AI ──────────────────────────────────────────────────
# MOCK_MODE=true  → deterministic, no API calls (dev-friendly)
# MOCK_MODE=false → uses OpenAI API (requires OPENAI_API_KEY)
MOCK_MODE=true

# Only required when MOCK_MODE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── n8n (optional automation) ───────────────────────────
# Set N8N_ENABLED=true to route AI calls through an n8n webhook
# instead of calling OpenAI directly. Falls back to direct on error.
N8N_ENABLED=false
N8N_WEBHOOK_URL=http://localhost:5678/webhook/job-analyze

# ─── Uploads ─────────────────────────────────────────────
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE_MB=5